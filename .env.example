# Hosted form endpoint for the quote form.
#   Formspree: VITE_FORM_ENDPOINT=https://formspree.io/f/<id>   (no key needed)
#   Web3Forms: VITE_FORM_ENDPOINT=https://api.web3forms.com/submit and VITE_FORM_ACCESS_KEY=<your key>
# Leave both empty and the form tells the visitor it isn't connected yet.
VITE_FORM_ENDPOINT=
VITE_FORM_ACCESS_KEY=
